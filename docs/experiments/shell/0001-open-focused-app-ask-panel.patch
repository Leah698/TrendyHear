+#[test]
+fn contained_open_may_request_the_shell_owned_ask_surface() {
+    let _g = serial();
+    let peers = Peers::new(Turn::Reply(json!({})));
+    register(true, &peers);
+    ask(APP, "octos.session.open", json!({"show": true}), false).expect("open");
+    assert_eq!(take_show_requests(), vec![APP.to_string()]);
+    let err = ask(APP, "octos.session.open", json!({"show": "yes"}), false).unwrap_err();
+    assert_eq!(err, UNSUPPORTED_ARGS);
+}
