+#[cfg(test)]
+mod calendar_receipt_tests {
+    use super::*;
+    #[test]
+    fn calendar_receipts_only_accept_bounded_host_success() {
+        let args = json!({"title":"Deadline", "start":"2026-10-15", "request_id":"test-1"});
+        let success = json!({"ok":true,"data":{"id":"event-1","start":"2026-10-15"}});
+        let receipt = calendar_receipt("os.calendar","calendar.add_event",&args,&success).unwrap();
+        assert_eq!(receipt["data"]["id"], "event-1");
+        assert_eq!(receipt["args"]["request_id"], "test-1");
+        assert!(calendar_receipt("os.mail","calendar.add_event",&args,&success).is_none());
+        assert!(calendar_receipt("os.calendar","calendar.remove_event",&args,&success).is_none());
+        assert!(calendar_receipt("os.calendar","calendar.add_event",&args,&json!({"ok":false})).is_none());
+        assert!(calendar_receipt("os.calendar","calendar.add_event",&args,&json!({"ok":true,"status":"waiting","data":{}})).is_none());
+        assert!(calendar_receipt("os.calendar","calendar.events",&args,&json!({"ok":true,"data":{"events":["x".repeat(32_000)]}})).is_none());
+    }
+}
