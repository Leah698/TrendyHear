diff --git a/crates/app-policy/tests/admission.rs b/crates/app-policy/tests/admission.rs
index 8ef3c02..23db0d5 100644
--- a/crates/app-policy/tests/admission.rs
+++ b/crates/app-policy/tests/admission.rs
@@ -569,3 +569,14 @@ fn old_runtime_or_missing_device_broker_never_activates_capture_side_effects() {
     // Declaring a capability does not manufacture an implemented host ABI.
     assert_eq!(old_runtime, public_runtime_capabilities(&[], true, false));
 }
+
+#[test]
+fn calendar_offer_keeps_explicit_requests_and_narrow_scope() {
+    let policy = resolve(r#""agent":{"profile":"read-only","tools":["calendar.events","calendar.add_event"]}"#).unwrap();
+    assert_eq!(policy.agent.unwrap().tools, ["calendar.events".to_string(), "calendar.add_event".to_string()].into_iter().collect());
+    let unrequested = resolve(r#""agent":{"profile":"read-only","tools":[]}"#).unwrap();
+    assert!(unrequested.agent.unwrap().tools.is_empty());
+    for tool in ["calendar.remove_event", "calendar.update_event", "device_calendar.events.create"] {
+        assert!(resolve(&format!(r#""agent":{{"profile":"read-only","tools":[{tool:?}]}}"#)).is_err());
+    }
+}
diff --git a/docs/PUBLISHING.md b/docs/PUBLISHING.md
