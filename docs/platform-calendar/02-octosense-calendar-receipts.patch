+/// Exercises the contained-app relay and Calendar's real local store.
+/// Admission is a fixture here; this is not a signed install or live LLM test.
+#[cfg(any(feature = "app-hub", native_mobile))]
+#[test]
+fn contained_calendar_action_requires_consent_and_survives_exact_retry() {
+    use super::script_apps::{self, HostServiceExecutor};
+    let folder = script_apps::tests::stamped_bundle("calendar", "contained-calendar-action", |_, _| {});
+    let calendar = script_apps::from_bundle(&folder).unwrap();
+    let root = folder.join("test-host");
+    octosense_calendar_service::register();
+    let mut relay = Relay::default();
+    relay.catalog.declare("os.calendar", calendar.tools);
+    relay.set_executor("os.calendar", Some(Arc::new(HostServiceExecutor {
+        app: "os.calendar".into(), tools: calendar.host_service_tools,
+        methods: calendar.host_methods, families: calendar.families, host_dir: root.clone(),
+    })));
+    let caller = "org.example.motion";
+    let mut world = World::new(FixedDevMode::off());
+    let invoke = |relay: &mut Relay, world: &mut World, id: &str, name: &str, args: Value| {
+        let mut request = call(id, name, &format!("card.{caller}"));
+        request.app = "os.calendar".into(); request.args = args;
+        let (r, sent) = reply(id);
+        relay.handle(Event::Call { call: request, reply: r }, world);
+        for _ in 0..100 {
+            script_apps::poll();
+            if !sent.lock().unwrap().is_empty() { break; }
+            std::thread::sleep(std::time::Duration::from_millis(10));
+        }
+        let result = sent.lock().unwrap().first().cloned().expect("bounded Calendar response");
+        result
+    };
+    let args = json!({"title":"Fictional opportunity deadline", "start":"2026-10-15",
+        "notes":"Fixture source only", "request_id":"contained-opportunity-1"});
+    assert_eq!(invoke(&mut relay, &mut world, "ungranted", "calendar.add_event", args.clone())["error"]["kind"], "not_granted");
+    assert!(octosense_calendar_service::load(&root).is_empty());
+    for tool in ["calendar.events", "calendar.add_event"] { relay.catalog.grant(caller, "os.calendar", tool); }
+    world.consent = false;
+    assert_eq!(invoke(&mut relay, &mut world, "no-consent", "calendar.add_event", args.clone())["error"]["kind"], "consent_pending");
+    assert!(octosense_calendar_service::load(&root).is_empty());
+    world.consent = true;
+    let saved = invoke(&mut relay, &mut world, "save", "calendar.add_event", args.clone());
+    assert_eq!(saved["ok"], true);
+    let retry = invoke(&mut relay, &mut world, "retry", "calendar.add_event", args.clone());
+    assert_eq!(retry["data"]["id"], saved["data"]["id"]);
+    let read = invoke(&mut relay, &mut world, "read-back", "calendar.events", json!({"from":"2026-10-15", "to":"2026-10-15", "limit":10}));
+    assert_eq!(read["ok"], true);
+    assert_eq!(read["data"]["events"].as_array().unwrap().len(), 1);
+    assert_eq!(read["data"]["events"][0]["id"], saved["data"]["id"]);
+    assert_eq!(read["data"]["events"][0]["request_id"], args["request_id"]);
+    assert_eq!(octosense_calendar_service::load(&root).len(), 1);
+    world.unavailable.insert(caller.into());
+    assert_eq!(invoke(&mut relay, &mut world, "withdrawn", "calendar.add_event", args)["error"]["kind"], "app_unavailable");
+    assert!(!relay.catalog.may_call(caller, "os.calendar", "calendar.remove_event", false));
+    std::fs::remove_dir_all(folder).unwrap();
+}
