+    fn open_requested_app_chat(&mut self, cx: &mut Cx) {
+        for requested in crate::ai_host::contained::take_show_requests() {
+            let Some(app) = self.focused_agent_app() else { continue };
+            if app.id == requested {
+                app_chat::open_app(app);
+                self.system_chat_changed(cx);
+            }
+        }
+    }
